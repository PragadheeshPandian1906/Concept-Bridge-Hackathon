# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=sk-or-your-key-here

# Model chain: primary -> fallback -> escalation
SLICE_MODEL=openai/gpt-4o-mini
SLICE_FALLBACK_MODEL=meta-llama/llama-3.1-8b-instruct
SLICE_ESCALATION_MODEL=anthropic/claude-3.5-sonnet

# Infrastructure bounds (NOT domain revision limits)
SLICE_MAX_TOKENS=900
SLICE_TEMPERATURE=0.2
SLICE_TOKEN_BUDGET=20000
SLICE_MAX_ATTEMPTS=8
SLICE_TIMEOUT=60
