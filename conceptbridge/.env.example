CONCEPTBRIDGE_DATABASE_PATH=runtime/conceptbridge.db
CONCEPTBRIDGE_MIN_GROUP_SIZE=2
CONCEPTBRIDGE_MAX_GROUP_SIZE=5
CONCEPTBRIDGE_STRENGTH_THRESHOLD=0.70
CONCEPTBRIDGE_GAP_THRESHOLD=0.60
CONCEPTBRIDGE_MIN_TRANSFER_GAP=0.20
CONCEPTBRIDGE_EFFECTIVE_GAIN_THRESHOLD=0.20
CONCEPTBRIDGE_MAX_TEACHING_LOAD=3
CONCEPTBRIDGE_DEMO_MODE=true
# Set DEMO_MODE=false and add your own key to .env to enable OpenRouter calls.
OPENROUTER_API_KEY=
CONCEPTBRIDGE_LLM_MODEL=openai/gpt-4.1-mini
CONCEPTBRIDGE_LLM_FALLBACK_MODEL=openai/gpt-4.1-mini
