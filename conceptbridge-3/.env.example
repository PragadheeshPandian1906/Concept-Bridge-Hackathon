# Leave DEMO_MODE=true (or omit the key) to run the whole system offline.
DEMO_MODE=true

# Real LLM calls (set DEMO_MODE=false to use them)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.1-8b-instruct
LLM_TIMEOUT=60
LLM_MAX_TOKENS=2000

DATABASE_URL=sqlite:///./runtime/conceptbridge.db
ARTIFACTS_DIR=./runtime/artifacts

# Domain thresholds
STRENGTH_THRESHOLD=0.70
GAP_THRESHOLD=0.60
MIN_TRANSFER_GAP=0.20
EFFECTIVE_GAIN_THRESHOLD=0.20
MIN_GROUP_SIZE=2
MAX_GROUP_SIZE=5
MAX_TEACHING_LOAD=3
HUB_OUT_DEGREE=3
BOTTLENECK_RATIO=3.0
QUESTIONS_PER_CONCEPT=3
